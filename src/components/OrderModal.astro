---

---

<div
  id="order-modal"
  class="order-modal"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="order-modal-title"
>
  <div class="order-modal__backdrop" data-order-action="close"></div>
  <div class="order-modal__panel" role="document" tabindex="-1">
    <header class="order-modal__header">
      <h2 class="order-modal__title" id="order-modal-title">Commander ma sélection</h2>
      <button
        type="button"
        class="order-modal__close"
        data-order-action="close"
        aria-label="Fermer"
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>
    <div class="order-modal__scroll">
    <div class="order-modal__customer" id="order-modal-customer">
      <p class="order-modal__customer-title">Livraison</p>
      <div class="order-modal__fields">
        <div class="order-modal__field order-modal__field--full">
          <label class="order-modal__label" for="order-customer-name">Nom</label>
          <input
            class="order-modal__input"
            type="text"
            id="order-customer-name"
            name="customer-name"
            autocomplete="name"
            required
          />
        </div>
        <div class="order-modal__field order-modal__field--full">
          <label class="order-modal__label" for="order-customer-address">Adresse</label>
          <input
            class="order-modal__input"
            type="text"
            id="order-customer-address"
            name="customer-address"
            autocomplete="street-address"
            required
          />
        </div>
        <div class="order-modal__field">
          <label class="order-modal__label" for="order-customer-postal">Code postal</label>
          <input
            class="order-modal__input"
            type="text"
            id="order-customer-postal"
            name="customer-postal"
            autocomplete="postal-code"
            inputmode="numeric"
            required
          />
        </div>
        <div class="order-modal__field">
          <label class="order-modal__label" for="order-customer-city">Ville</label>
          <input
            class="order-modal__input"
            type="text"
            id="order-customer-city"
            name="customer-city"
            autocomplete="address-level2"
            required
          />
        </div>
      </div>
      <p class="order-modal__hint" id="order-modal-hint" hidden>
        Renseignez vos coordonnées de livraison pour envoyer ou copier la commande.
      </p>
    </div>
    <div id="order-modal-list" class="order-modal__list"></div>
    </div>
    <footer class="order-modal__footer">
      <p class="order-modal__total">
        Total
        <span class="order-modal__total-amount">
          <span class="order-modal__total-value" id="order-modal-total">—</span>
          <span class="order-modal__total-ttc">TTC</span>
        </span>
      </p>
      <div class="order-modal__actions">
        <button
          type="button"
          id="order-modal-copy"
          class="order-modal__cta order-modal__cta--secondary"
        >
          Copier la commande
        </button>
        <a
          id="order-modal-mailto"
          class="order-modal__cta"
          href={`mailto:cavesecretoprivado@proton.me?subject=commande`}
        >
          Envoyer la commande par e-mail
        </a>
      </div>
    </footer>
  </div>
</div>
