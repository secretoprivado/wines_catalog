---
interface Props {
  page?: 'catalog' | 'about';
}

const { page = 'catalog' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<nav class="catalog-tabs" id="catalog-tabs" aria-label="Catalogue">
  <div class="catalog-tabs__list" role={page === 'catalog' ? 'tablist' : undefined}>
    {page === 'catalog' ? (
      <>
        <button
          type="button"
          class="catalog-tabs__tab is-active"
          role="tab"
          id="tab-vins"
          data-catalog="vins"
          aria-selected="true"
          aria-controls="catalog"
        >
          Vins
        </button>
        <button
          type="button"
          class="catalog-tabs__tab"
          role="tab"
          id="tab-spiritueux"
          data-catalog="spiritueux"
          aria-selected="false"
          aria-controls="catalog"
        >
          Spiritueux
        </button>
        <a class="catalog-tabs__tab" href={`${base}services/`} aria-label="Moi et mes services">
          <span class="catalog-tabs__label catalog-tabs__label--long">Moi et mes services</span>
          <span class="catalog-tabs__label catalog-tabs__label--short">Services</span>
        </a>
        <button
          type="button"
          class="catalog-tabs__tab"
          role="tab"
          id="tab-selection"
          data-catalog="selection"
          aria-selected="false"
          aria-controls="catalog"
          aria-label="Ma sélection"
        >
          <span class="catalog-tabs__label catalog-tabs__label--long">Ma sélection</span>
          <span class="catalog-tabs__label catalog-tabs__label--short">Sélection</span>
          <span class="catalog-tabs__badge" id="selection-badge" hidden aria-hidden="true"></span>
        </button>
      </>
    ) : (
      <>
        <a class="catalog-tabs__tab" href={`${base}?catalog=vins`}>Vins</a>
        <a class="catalog-tabs__tab" href={`${base}?catalog=spiritueux`}>Spiritueux</a>
        <a
          class="catalog-tabs__tab is-active"
          href={`${base}services/`}
          aria-current="page"
          aria-label="Moi et mes services"
        >
          <span class="catalog-tabs__label catalog-tabs__label--long">Moi et mes services</span>
          <span class="catalog-tabs__label catalog-tabs__label--short">Services</span>
        </a>
        <a class="catalog-tabs__tab" href={`${base}?catalog=selection`} aria-label="Ma sélection">
          <span class="catalog-tabs__label catalog-tabs__label--long">Ma sélection</span>
          <span class="catalog-tabs__label catalog-tabs__label--short">Sélection</span>
        </a>
      </>
    )}
  </div>
</nav>
